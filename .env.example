# ===== ฐานข้อมูลเนื้อหาเว็บ =====
# ใช้ connection string ของ Supabase project "hiclass-ev-car"
# เอาจาก Supabase > Project Settings > Database > Connection string > URI
# หมายเหตุ: ตารางของเว็บอยู่ใน schema ชื่อ cms แยกจาก public ที่เป็นของ CRM
DATABASE_URI=postgres://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# สตริงลับสำหรับเข้ารหัส session ของหลังบ้าน — สุ่มใหม่ ห้ามใช้ค่าตัวอย่าง
# สร้างด้วย: openssl rand -base64 32
PAYLOAD_SECRET=

# ===== ระบบ CRM (สำหรับส่งลีดทดลองขับ) =====
# URL ของ Supabase project เดียวกัน เช่น https://bivrzphxfmudsvtkcnpl.supabase.co
CRM_SUPABASE_URL=
# service_role key — ห้ามใส่ใน NEXT_PUBLIC_ และห้าม commit ลง git เด็ดขาด
CRM_SUPABASE_SERVICE_KEY=

# ===== ที่เก็บรูป =====
# บน Vercel (ไม่มีดิสก์ถาวร) ให้ใช้ Supabase Storage — สร้าง bucket ชื่อ media แบบ Public
# แล้วเอากุญแจจาก Supabase > Storage > S3 Access Keys
S3_BUCKET=media
S3_ENDPOINT=https://bivrzphxfmudsvtkcnpl.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ถ้าโฮสต์บนเซิร์ฟเวอร์ที่มีดิสก์ถาวร ให้เว้น S3_* ว่างไว้ แล้วใช้ค่านี้แทน
# MEDIA_DIR=/path/นอกโฟลเดอร์โปรแกรม/media

NEXT_PUBLIC_SITE_URL=https://hiclassevcar.com
